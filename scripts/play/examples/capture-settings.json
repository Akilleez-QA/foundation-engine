  "cases": [
    {
      "id": "phone-sound-journey",
      "profile": "phone",
      "scene": "main",
      "task": "Open stock Settings, toggle Sound, then reopen to inspect the changed state",
      "criteria": [
        "Sound control remains reachable in the selected viewport",
        "The changed Sound label is readable and understandable"
      ],
      "steps": [
        {
          "tap": "details.shell-menu > summary"
        },
        {
          "waitFor": {
            "selector": "#shell-sound:text-is(\"Sound: on\")",
            "state": "visible"
          }
        },
        {
          "tap": "#shell-sound"
        },
        {
          "waitFor": {
            "selector": "details.shell-menu[open]",
            "state": "hidden"
          }
        },
        {
          "tap": "details.shell-menu > summary"
        },
        {
          "waitFor": {
            "selector": "#shell-sound:text-is(\"Sound: off\")",
            "state": "visible"
          }
        }
      ]
    },
