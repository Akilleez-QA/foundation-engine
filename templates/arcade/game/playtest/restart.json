{
  "name": "restart",
  "description": "S3 in a browser: after game over, the restart action starts a fresh run with score zero.",
  "scene": "play",
  "seed": 5,
  "steps": [
    {"snap": "start"},
    {"expect": {"path": "world.state.phase", "equals": "playing"}},
    {"key": "ArrowLeft", "ms": 600},
    {"waitUntil": {"path": "world.state.phase", "equals": "over"}, "ms": 40000},
    {"expect": {"path": "world.state.phase", "equals": "over"}},
    {"snap": "game-over"},
    {"press": " "},
    {"waitUntil": {"path": "world.state.phase", "equals": "playing"}, "ms": 20000},
    {"expect": {"path": "world.state.phase", "equals": "playing"}},
    {"expect": {"path": "world.state.score", "equals": 0}},
    {"expect": {"path": "world.state.best", "atLeast": 1}},
    {"snap": "restarted"}
  ]
}
